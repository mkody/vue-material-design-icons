{
  "name": "@mkody/vue-material-design-icons",
  "version": "5.0.10",
  "author": "Rob Cresswell <robcresswell@pm.me>",
  "contributors": [
    {
      "name": "André Kody Fernandes",
      "email": "gh@kdy.ch",
